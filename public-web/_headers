# En-têtes du site, lus par Cloudflare Pages (voir ARCHITECTURE.md, « Version web »).
# img-src reste large : les boutiques renvoient les adresses de leurs images, et leurs hôtes changent.
# media-src en joker : Steam répond akamai ou fastly selon la région de celui qui demande.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src https://*.steamstatic.com; connect-src 'self' https://torii-api.topo-host.com https://torii-store.topo-host.com; frame-src https://challenges.cloudflare.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Les noms de ces fichiers changent avec leur contenu.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
