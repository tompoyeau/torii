    <loc>https://torii-app.fr/en/</loc>
    <lastmod>2026-09-13</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="fr" href="https://torii-app.fr/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://torii-app.fr/en/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://torii-app.fr/en/" />
  </url>
  <!--
    Les notes de version changent à chaque release : ce sont les seules pages du site dont
    le contenu bouge vraiment, d'où `weekly`. `lastmod` est à remettre à jour en même
    temps que les pages (`npm run build:notes`), dans les deux langues.
  -->
  <url>
