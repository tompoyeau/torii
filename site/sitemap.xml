<?xml version="1.0" encoding="UTF-8"?>
<!--
  Les pages qui existent dans les deux langues déclarent leurs équivalents (`xhtml:link`).
  🔑 Même règle que dans les `<head>` : chaque URL liste TOUTES les versions, elle-même
  comprise. Une déclaration à sens unique est ignorée.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://torii-app.fr/</loc>
    <lastmod>2026-09-13</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="fr" href="https://torii-app.fr/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://torii-app.fr/en/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://torii-app.fr/en/" />
  </url>
