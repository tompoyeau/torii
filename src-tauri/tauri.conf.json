{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torii",
  "version": "0.12.1",
  "identifier": "com.tompo.ludo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Torii",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MTk5M0FFRTBBNEZFNjYKUldSbS9xVGdycE1aaVhJSzFzWXV3RS9OQnJIZHE1WW13aFlrMnZsSkl3R3NTeHdaS2l1ZlQydkQK",
      "endpoints": [
        "https://github.com/tompoyeau/torii/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
